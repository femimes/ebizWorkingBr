<%@ Register TagPrefix="dx" Namespace="DevExpress.Data" Assembly="DevExpress.Data.v19.1, Version=19.1.4.0,    Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dxe" Namespace="DevExpress.Web.ASPxEditors" Assembly="DevExpress.Web.v19.1,  Version=19.1.4.0,    Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dxrp" Namespace="DevExpress.Web.ASPxRoundPanel" Assembly="DevExpress.Web.v19.1, Version=19.1.4.0,    Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dxnb" Namespace="DevExpress.Web.ASPxNavBar" Assembly="DevExpress.Web.v19.1, Version=19.1.4.0,   Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dxm" Namespace="DevExpress.Web.ASPxMenu" Assembly="DevExpress.Web.v19.1, Version=19.1.4.0,    Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register Assembly="DevExpress.Web.v19.1, Version=19.1.4.0,    Culture=neutral, PublicKeyToken=b88d1754d700e49a" Namespace="DevExpress.Web.ASPxPanel" TagPrefix="dx" %>

<%-- ASPxImage --%>
<dxe:ASPxImage runat="server" SkinID="TopLeftCorner" Width="6" Height="65" ImageUrl="Demo/TopLeftCorner.png" />
<dxe:ASPxImage runat="server" SkinID="TopRightCorner" Width="65" Height="65" ImageUrl="Demo/TopRightCorner.png" />
<dxe:ASPxImage runat="server" SkinID="BottomLeftCorner" Width="6" Height="6" ImageUrl="Demo/BottomLeftCorner.png" />
<dxe:ASPxImage runat="server" SkinID="BottomRightCorner" Width="6" Height="6" ImageUrl="Demo/BottomRightCorner.png" />
<dxe:ASPxImage runat="server" SkinID="Copyright" Width="164" Height="47" ImageUrl="Demo/Copyright.png" />

<%-- ASPxHyperLink --%>
<dxe:ASPxHyperLink runat="server" SkinID="Logotype" ImageWidth="231px" ImageHeight="61px" />

<%-- ASPxRoundPanel --%>
<dxrp:ASPxRoundPanel runat="server" SkinID="Banner" Width="230px">
    <ContentPaddings PaddingTop="29px" PaddingBottom="0px" PaddingLeft="6px" PaddingRight="6px" />
    
  
    <Content BackColor="transparent">
        <BackgroundImage Repeat="NoRepeat" VerticalPosition="top" HorizontalPosition="left" ImageUrl="Demo/BannerContent.gif" />
    </Content>
  
   
</dxrp:ASPxRoundPanel>

<%-- ASPxRoundPanel Navigation --%>
<dxrp:ASPxRoundPanel SkinID="RoundPanelNavigation" runat="server"  ShowHeader="False"
	ImageFolder="Demo/RoundPanelNavigation/">
	
		<ContentPaddings Padding="0px" />
	<Border BorderWidth="0px" />
</dxrp:ASPxRoundPanel>

<%-- ASPxNavBar Navigation --%>
<dxnb:ASPxNavBar SkinID="NavBarNavigation" runat="server" ImageFolder="Demo/NavBarNavigation/"
    CssFilePath="Demo/NavBarNavigation/styles.css"
    CssPostfix="GlassNavigation" AutoCollapse="True" GroupSpacing="0px">
    <GroupContentStyle ItemSpacing="3px" />
    <CollapseImage Height="14px" Width="14px" Url="Demo/NavBarNavigation/nbCollapse.png" />
    <ExpandImage Height="0px" Width="0px" Url="Demo/NavBarNavigation/nbExpand.gif" />
</dxnb:ASPxNavBar>

<%-- ASPxRoundPanel GroupBox --%>
<dxrp:ASPxRoundPanel SkinID="RoundPanelGroupBox" runat="server" 
    View="GroupBox" BackColor="White" GroupBoxCaptionOffsetX="17px">
    <Border BorderColor="#7EACB1" BorderStyle="Solid" BorderWidth="1px" />
    <HeaderStyle BackColor="White" ForeColor="#346DAD" />
</dxrp:ASPxRoundPanel>

<%-- ASPxMenu ChartDemoToolbar --%>
<dxm:ASPxMenu runat="server" CssFilePath="Demo/ChartDemoToolbar/styles.css" SkinID="ChartDemoToolbar"
    ItemSpacing="0px" CssPostfix="GlassChartDemoToolbar" SeparatorHeight="100%" AutoSeparators="RootOnly">
    <Border BorderStyle="Solid" BorderWidth="1px" BorderColor="#A5A6A8" />
    <Paddings PaddingLeft="0px" PaddingRight="0px" />
</dxm:ASPxMenu>

<%-- ASPxDropDownEdit CheckComboBox --%>
<dxe:ASPxDropDownEdit runat="server" SkinID="CheckComboBox" CssFilePath="{0}/styles.css" CssPostfix="Office2010Silver">
    <ValidationSettings>
        <ErrorFrameStyle ImageSpacing="4px">
            <ErrorTextPaddings PaddingLeft="4px"></ErrorTextPaddings>
        </ErrorFrameStyle>
    </ValidationSettings>
    <ButtonStyle Width="13px"></ButtonStyle>
    <DropDownWindowStyle BackColor="#D5E9F3" />
</dxe:ASPxDropDownEdit>

<%-- ASPxListBox CheckComboBox --%>
<dxe:ASPxListBox runat="server" SkinID="CheckComboBoxListBox" CssPostfix="Office2010Silver" CssFilePath="{0}/styles.css">
    <ValidationSettings>
        <ErrorFrameStyle ImageSpacing="4px">
            <ErrorTextPaddings PaddingLeft="4px"></ErrorTextPaddings>
        </ErrorFrameStyle>
    </ValidationSettings>
    <Border BorderStyle="None" />
    <BorderBottom BorderStyle="Solid" BorderWidth="1px" BorderColor="#C2D8DA" />
    <LoadingPanelImage Url="Editors/Loading.gif"></LoadingPanelImage>
</dxe:ASPxListBox>
