<%@ Register TagPrefix="dx" Namespace="DevExpress.Data" Assembly="DevExpress.Data.v19.1, Version=19.1.4.0,   Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dxsm" Namespace="DevExpress.Web" Assembly="DevExpress.Web.v19.1, Version=19.1.4.0,   Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>

<dxsm:ASPxSiteMapControl runat="server" CssFilePath="{0}/styles.css" CssPostfix="Office2010Silver">
    <LevelProperties>
        <dxsm:LevelProperties BulletStyle="None">
            <ChildNodesPaddings PaddingTop="7px" PaddingBottom="5px" PaddingLeft="22px"></ChildNodesPaddings>
        </dxsm:LevelProperties>
        <dxsm:LevelProperties BulletStyle="None" NodeSpacing="7px">
            <ChildNodesPaddings PaddingLeft="19px"></ChildNodesPaddings>
        </dxsm:LevelProperties>
        <dxsm:LevelProperties NodeSpacing="4px"></dxsm:LevelProperties>
    </LevelProperties>
</dxsm:ASPxSiteMapControl>

