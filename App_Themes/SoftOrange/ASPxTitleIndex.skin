<%@ Register TagPrefix="dx" Namespace="DevExpress.Data" Assembly="DevExpress.Data.v19.1, Version=19.1.4.0,   Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>
<%@ Register TagPrefix="dxti" Namespace="DevExpress.Web" Assembly="DevExpress.Web.v19.1, Version=19.1.4.0,   Culture=neutral, PublicKeyToken=b88d1754d700e49a" %>

<dxti:ASPxTitleIndex runat="server" BackToTopSpacing="2px" CssFilePath="{0}/styles.css" SpriteCssFilePath="{0}/sprite.css" ImageFolder="{0}/" FilterBoxSpacing="12px" CssPostfix="Office2010Silver">
	<BackToTopImage>
		<SpriteProperties CssClass="dxWeb_tiBackToTop_Glass"></SpriteProperties>
	</BackToTopImage>
	<LoadingPanelImage Url="Web/Loading.gif"></LoadingPanelImage>

	<Columns>
		<dxti:TitleIndexColumn />
		<dxti:TitleIndexColumn />
	</Columns>

	<FilterBox Caption="Filter:&amp;nbsp;&amp;nbsp;" HorizontalPosition="Left"></FilterBox>

	<ColumnStyle>
		<Paddings PaddingLeft="0px"></Paddings>
	</ColumnStyle>
	<IndexPanelStyle HorizontalAlign="Left"></IndexPanelStyle>
	<GroupContentStyle ItemSpacing="2px"></GroupContentStyle>
	<IndexPanelSeparatorStyle Height="0px"></IndexPanelSeparatorStyle>
	<DisabledStyle ForeColor="#93a1a4"></DisabledStyle>
</dxti:ASPxTitleIndex>

