<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>eBusiness Plus</title>
    <link rel="shortcut icon" href="/Resources/images/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style type="text/css">
        /* ===== eBusiness Plus theme (same palette as the login page and the rewritten modules) ===== */
        :root {
            --brand: #0F4C81; --brand-dark: #0a355a;
            --ink: #14212e; --muted: #5d6b7a;
            --line: #e1e8ef; --field: #d3dce6;
            --page: #f4f7fa; --surface: #ffffff; --tint: #eaf1f8;
            --ok: #1b6e3c; --ok-bg: #e6f4ea;
            --bad: #b3261e; --bad-bg: #fdeceb;
            --ring: rgba(15, 76, 129, .22);
        }
        * { box-sizing: border-box; }
        html, body { min-height: 100%; }
        body {
            margin: 0;
            font-family: "Plus Jakarta Sans", "Segoe UI", Roboto, Arial, sans-serif;
            font-size: 14px; line-height: 1.5; color: var(--ink); background: var(--page);
            -webkit-font-smoothing: antialiased;
        }
        a { color: var(--brand); }
        a:hover { color: var(--brand-dark); }

        /* ----- app shell ----- */
        .shell { min-height: 100vh; display: flex; flex-direction: column; }
        .topbar {
            position: sticky; top: 0; z-index: 20;
            background: linear-gradient(120deg, var(--brand) 0%, #082c4d 100%);
            color: #fff; box-shadow: 0 2px 12px rgba(8, 44, 77, .25);
        }
        .topbar-inner {
            max-width: 1200px; margin: 0 auto; padding: 0 24px; height: 60px;
            display: flex; align-items: center; gap: 28px;
        }
        .brand { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-weight: 700; font-size: 17px; letter-spacing: -.01em; white-space: nowrap; }
        .brand:hover { color: #fff; }
        .brand-mark {
            display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px;
            border-radius: 8px; background: rgba(255, 255, 255, .16); font-size: 14px; font-weight: 700;
        }

        /* asp:Menu renders <div><ul class="level1">... */
        .nav { flex: 1 1 auto; min-width: 0; }
        .nav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 4px; }
        .nav li { position: relative; }
        .nav a, .nav a.static {
            display: block; padding: 8px 14px; border-radius: 8px;
            color: rgba(255, 255, 255, .85); text-decoration: none; font-weight: 600; font-size: 14px;
        }
        .nav a:hover { color: #fff; background: rgba(255, 255, 255, .12); }
        .nav a.selected, .nav a.current { color: #fff; background: rgba(255, 255, 255, .18); }
        .nav .skip-link { display: none; }

        .account { display: flex; align-items: center; gap: 12px; white-space: nowrap; font-size: 13px; }
        .account .who { display: inline-flex; align-items: center; gap: 8px; color: rgba(255, 255, 255, .9); }
        .account .avatar {
            display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%;
            background: #fff; color: var(--brand); font-weight: 700; font-size: 13px; text-transform: uppercase;
        }
        .account a {
            display: inline-block; padding: 7px 14px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, .5);
            color: #fff; text-decoration: none; font-weight: 600;
        }
        .account a:hover { color: #fff; background: rgba(255, 255, 255, .12); }

        .main { flex: 1 0 auto; width: 100%; max-width: 1200px; margin: 0 auto; padding: 28px 24px 40px; }
        .footer { border-top: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: 12px; }
        .footer-inner { max-width: 1200px; margin: 0 auto; padding: 14px 24px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

        /* ----- content defaults for pages that use this master ----- */
        .main h1, .main h2, .main h3 { font-variant: normal; text-transform: none; color: var(--ink); letter-spacing: -.01em; }
        .main h2 { margin: 0 0 8px; font-size: 22px; font-weight: 700; }
        .main h3 { margin: 18px 0 8px; font-size: 16px; font-weight: 700; }
        .main p { margin: 0 0 12px; }
        .clear { clear: both; }
        .bold { font-weight: 700; }
        .inline { display: inline; }

        /* forms: classic Account pages (accountInfo / textEntry / passwordEntry / submitButton) */
        fieldset {
            margin: 16px 0; padding: 20px 22px 8px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface);
        }
        legend { padding: 0 8px; font-size: 13px; font-weight: 700; color: var(--brand); }
        .accountInfo { max-width: 460px; }
        .main label { font-weight: 600; font-size: 13px; color: #33414f; }
        .main label.inline { font-weight: 500; }
        .textEntry, .passwordEntry, .main .form-control,
        .main input[type="text"], .main input[type="password"], .main input[type="email"], .main input[type="date"], .main select, .main textarea {
            width: 100%; max-width: 100%; padding: 10px 12px; margin: 4px 0 10px;
            font: inherit; font-size: 14px; color: var(--ink);
            background: var(--surface); border: 1px solid var(--field); border-radius: 8px;
            transition: border-color .15s, box-shadow .15s;
        }
        .textEntry:focus, .passwordEntry:focus, .main .form-control:focus,
        .main input[type="text"]:focus, .main input[type="password"]:focus, .main select:focus, .main textarea:focus {
            outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--ring);
        }
        .main input[type="checkbox"] { width: 16px; height: 16px; margin: 0 6px 0 0; vertical-align: middle; accent-color: var(--brand); }
        .submitButton { margin: 4px 0 20px; text-align: left; }
        .submitButton input, .main input[type="submit"], .main button.btn, .main .btn {
            display: inline-block; padding: 10px 20px; border: 0; border-radius: 8px;
            font: inherit; font-size: 14px; font-weight: 600; color: #fff; background: var(--brand);
            cursor: pointer; text-decoration: none; transition: background .15s;
        }
        .submitButton input:hover, .main input[type="submit"]:hover, .main .btn:hover { background: var(--brand-dark); color: #fff; }
        .failureNotification { display: block; color: var(--bad); font-weight: 500; }
        .failureNotification:empty { display: none; }
        ul.failureNotification, div.failureNotification > ul { margin: 0 0 12px; padding: 10px 14px 10px 32px; border-radius: 8px; background: var(--bad-bg); }

        /* login card layout (Account/Auth.aspx) */
        .login-container {
            min-height: 520px; display: flex; justify-content: center; align-items: center; padding: 24px 0;
        }
        .login-card {
            width: 100%; max-width: 420px; padding: 36px; border: 1px solid var(--line); border-radius: 14px;
            background: var(--surface); box-shadow: 0 12px 30px rgba(15, 76, 129, .10);
        }
        .logo-section { text-align: center; margin-bottom: 24px; }
        .logo-section img { width: 180px; max-width: 100%; }
        .page-title { text-align: center; font-size: 26px; font-weight: 700; margin: 0 0 4px; }
        .page-subtitle { text-align: center; color: var(--muted); margin: 0 0 24px; }
        .form-group { margin-bottom: 16px; }
        .form-label { display: block; margin-bottom: 6px; font-weight: 600; color: #33414f; }
        .login-btn {
            width: 100%; height: 46px; border: 0; border-radius: 8px; cursor: pointer;
            font: inherit; font-size: 15px; font-weight: 600; color: #fff; background: var(--brand);
        }
        .login-btn:hover { background: var(--brand-dark); }
        .remember-section { margin: 8px 0 20px; }

        @media (max-width: 760px) {
            .topbar-inner { height: auto; padding: 10px 16px; flex-wrap: wrap; gap: 10px; }
            .nav { order: 3; flex-basis: 100%; overflow-x: auto; }
            .account { margin-left: auto; }
            .main { padding: 20px 16px 32px; }
            .login-card { padding: 26px 20px; }
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
    <div class="shell">
        <header class="topbar">
            <div class="topbar-inner">
                <asp:HyperLink ID="lnkBrand" runat="server" CssClass="brand" NavigateUrl="~/Default.aspx"><span class="brand-mark" aria-hidden="true">e+</span>eBusiness Plus</asp:HyperLink>

                <nav class="nav" aria-label="Main">
                    <asp:Menu ID="NavigationMenu" runat="server" EnableViewState="false" IncludeStyleBlock="false" Orientation="Horizontal"
                        RenderingMode="List" SkipLinkText="" StaticSelectedStyle-CssClass="current">
                        <Items>
                            <asp:MenuItem NavigateUrl="~/Default.aspx" Text="Home" />
                            <asp:MenuItem NavigateUrl="~/About.aspx" Text="About" />
                        </Items>
                    </asp:Menu>
                </nav>

                <div class="account">
                    <asp:LoginView ID="HeadLoginView" runat="server" EnableViewState="false">
                        <AnonymousTemplate>
                            <a href="~/Account/Login.aspx" id="HeadLoginStatus" runat="server">Log in</a>
                        </AnonymousTemplate>
                        <LoggedInTemplate>
                            <span class="who"><span class="avatar" aria-hidden="true"><asp:Literal ID="litInitial" runat="server" /></span><asp:Literal ID="litUser" runat="server" /></span>
                            <asp:LoginStatus ID="HeadLoginStatus" runat="server" LogoutAction="Redirect" LogoutText="Log out" LoginText="Log in" LogoutPageUrl="~/Account/Login.aspx" />
                        </LoggedInTemplate>
                    </asp:LoginView>
                </div>
            </div>
        </header>

        <main class="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="footer">
            <div class="footer-inner">
                <span>&copy; <asp:Literal ID="litYear" runat="server" /> eBusiness Plus</span>
                <span>Back-office banking</span>
            </div>
        </footer>
    </div>
    </form>
</body>
</html>
