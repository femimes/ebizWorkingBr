    private void ReleaseScardFunction()
    {
        short nRet = 0;

        if (hDev.Equals(0) || hDev.Equals(-1))
        {
            hDev = IntPtr.Zero;
            return;
        }

        //SOY_SC_Beep(hDev, 10);
