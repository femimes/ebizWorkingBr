    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
    public static extern UInt32 SOY_PR_PrintTextW(int nX, int nY, string szTextW, string szFontNameW, int nFontHeight, int nFontWeight, byte byFontAttribute, byte byCharSet, UInt32 dwTextColor, bool bTransparentBack);

    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
    public static extern UInt32 SOY_PR_PrintImage2W(IntPtr hDC, int nX, int nY, int nWidth, int nHeight, string szImageUrlW);

    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
    public static extern UInt32 SOY_PR_PrintText2W(IntPtr hDC, int nX, int nY, string szTextW, string szFontNameW, int nFontHeight, int nFontWeight, byte byFontAttribute, byte byCharSet, UInt32 dwTextColor, bool bTransparentBack);

    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
    public static extern UInt32 SOY_PR_SdkVersionW([Out] char[] szVersionOut);

    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
