    //    }

    //    textBoxUhfResult.AppendText("Write data successfully.\n");
    //}


    #endregion


    protected void Button1_Click(object sender, EventArgs e)
    {
        uint dwRet = 0;
        string printerName = comboBoxPrinter.Text;

        uint dwMode = 0x00000001;


        char[] T1 = null;
        char[] T2 = null;
        char[] T3 = null;

        textBoxT1R.Text = "";
        textBoxT2R.Text = "";
        textBoxT3R.Text = "";

        if (checkBoxT1.Checked)
        {
            T1 = new char[256];
            Array.Clear(T1, 0, 256);
        }
        if (checkBoxT2.Checked)
        {
            T2 = new char[256];
            Array.Clear(T2, 0, 256);
        }
        if (checkBoxT3.Checked)
        {
            T3 = new char[256];
            Array.Clear(T3, 0, 256);
        }

        dwRet = SOY_PR_ReadTrackW(printerName, dwMode, T1, T2, T3);

        if (checkBoxT1.Checked)
            textBoxT1R.Text = new string(T1);
        if (checkBoxT2.Checked)
            textBoxT2R.Text = new string(T2);
        if (checkBoxT3.Checked)
            textBoxT3R.Text = new string(T3);

        string infoString = null;
        //infoString = String.Format("Return = {0} \n\n {1}", dwRet, ErrorMap[dwRet]);
    }
}

