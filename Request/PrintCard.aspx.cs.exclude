    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
    public static extern UInt32 SOY_PR_StartPrintingW(string szPrinter, ref SEAORY_DOC_PROP lpInDocProp);

    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
    public static extern UInt32 SOY_PR_StartPage();

    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
    public static extern UInt32 SOY_PR_EndPrinting();

    [DllImport("SeaorySDK.dll", CharSet = CharSet.Unicode)]
