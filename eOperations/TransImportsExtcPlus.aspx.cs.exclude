    protected void Button1_Click(object sender, EventArgs e)
    {
        try
        {
            string str = this.UploadMultipleFiles_Clicked();
            if (Microsoft.VisualBasic.CompilerServices.Operators.CompareString(str, (string)null, false) == 0)
                return;
            if (Conversions.ToDouble(this.drptranstype.SelectedValue) == 2.0)
                this.InsertAllRecords(str);
            else if (Conversions.ToDouble(this.drptranstype.SelectedValue) == 3.0)
                this.InsertAllRecordsPromo(str);
            else if (Conversions.ToDouble(this.drptranstype.SelectedValue) == 4.0)
                this.InsertAllRecordsPromoAccts(str);
            else if (Conversions.ToDouble(this.drptranstype.SelectedValue) == 7.0)
                this.InsertAllRecords(str);
            else if (Conversions.ToDouble(this.drptranstype.SelectedValue) == 11.0)
                this.InsertAllRecordsTrans(str);
            else
                this.InsertAllRecordHr(str);
        }
        catch (Exception ex)
        {
            ProjectData.SetProjectError(ex);
            this.Response.Write("<script>alert('Invalid file format " + ex.Message + "') </script>");
            ProjectData.ClearProjectError();
        }
    }
