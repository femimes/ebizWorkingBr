    public string UploadMultipleFiles_Clicked()
    {
        string path = "C:\\TempMultipleFiles\\";
        string str1;
        try
        {
            int num1 = 0;
            int num2 = checked(this.Request.Files.Count - 1);
            int index = num1;
            string str2;
            string Left;
            while (index <= num2)
            {
                HttpPostedFile httpPostedFile = this.Request.Files[index];
                if (!(httpPostedFile == null | Microsoft.VisualBasic.CompilerServices.Operators.CompareString(httpPostedFile.FileName, "", false) == 0 | httpPostedFile.ContentLength < 1))
                {
                    str2 = Path.GetFileName(httpPostedFile.FileName);
                    if (!Directory.Exists(path))
                        Directory.CreateDirectory(path);
                    httpPostedFile.SaveAs(path + str2);
                    Left = Left + "Uploaded File: " + httpPostedFile.FileName + " of type " + httpPostedFile.ContentType + " <br> ";
                }
                checked { ++index; }
            }
            if (Microsoft.VisualBasic.CompilerServices.Operators.CompareString(Left, "", false) == 0)
            {
                Left = "Select the file to upload or import.";
                str2 = (string)null;
            }
            this.Response.Write("<script>alert('" + Left + "') </script>");
            str1 = str2;
        }
        catch (Exception ex)
        {
            ProjectData.SetProjectError(ex);
            ex.ToString();
            ProjectData.ClearProjectError();
        }
        return str1;
    }

    protected void Button3_Click(object sender, EventArgs e)
    {
        luser = this.Context.User.Identity.Name;
        StrLocation = luser.Substring(checked(luser.LastIndexOf("?") + 1));
        struser = Strings.Mid(luser, 1, luser.LastIndexOf("?"));
        guser = struser;
        if (Microsoft.VisualBasic.CompilerServices.Operators.CompareString(Strings.Trim(struser), "", false) != 0)
        {
