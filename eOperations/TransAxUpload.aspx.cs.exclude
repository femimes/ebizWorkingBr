                    str4 = NETClass.EazyClass.FullAccount(this.StrLocation, str4);
                dataGridItem.Cells[11].CssClass = Convert.ToString(1);
                if (DateTime.Compare(Convert.ToDate(str2), Convert.ToDate(Classes.GetDataset("SELECT PostingDate FROM PrmPostingDates WHERE Record = 1").Tables[0].Rows[0]["PostingDate"].ToString())) > 0)
                {
                    str1 = str1 + dataGridItem.Cells[2].Text + "<br>,";
