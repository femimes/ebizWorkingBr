                string rString2 = string.Format("SELECT AccountNo FROM VwAccMaster WHERE AccountNo = '{0}' AND AccountStatus = 1 ",  str4);
                string rString3 = string.Format("SELECT AccountNo FROM VwAccMaster WHERE AccountNo = '{0}' AND ProdCatCode IN ('1','2','Z')",  str4);
                string rString4 = string.Format("SELECT AccountNo FROM VwAccMaster WHERE AccountNo = '{0}' AND PostingDateAdded > {1} ",  str4,  Convert.ToDate(str2));
