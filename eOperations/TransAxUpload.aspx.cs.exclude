    public void InsertAllRecordsPromoAccts(string m_strFileName)
    {
        this.luser = this.Context.User.Identity.Name;
        this.StrLocation = this.luser.Substring(checked(this.luser.LastIndexOf("?") + 1));
        this.struser = Strings.Mid(this.luser, 1, this.luser.LastIndexOf("?"));
        this.guser = this.struser;
        DataSet dataSet1 = new DataSet();
        DataTable dataTable = new DataTable();
        dataTable.Columns.Add(new DataColumn("Account RefNo ", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Post Date", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Trans Date", typeof(string)));
        dataTable.Columns.Add(new DataColumn("CustomerNo", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Title ", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Customer ProfileName  ", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Sex", typeof(string)));
        dataTable.Columns.Add(new DataColumn("DateOfBirth", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Old NETAcctNo  ", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Old NETAcctRefName", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Customer ContactAddress", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Telephone", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Product Description", typeof(string)));
        dataTable.Columns.Add(new DataColumn("BranchCode", typeof(string)));
        dataTable.Columns.Add(new DataColumn("SystemRemarks", typeof(string)));
        DataSet dataSet2 = new DataSet();
        XmlTextReader xmlTextReader = new XmlTextReader((Stream)new FileStream("C:\\TempMultipleFiles\\" + m_strFileName, FileMode.Open));
        int num = (int)dataSet2.ReadXml((XmlReader)xmlTextReader);
        xmlTextReader.Close();
        try
        {
            foreach (DataRow dataRow in dataSet2.Tables[0].Rows)
            {
                DataRow row = dataTable.NewRow();
                row[0] = RuntimeHelpers.GetObjectValue(dataRow["old_account_no"]);
                row[1] =  Strings.Format( EazyClass.GetPostingDate(), "dd-MMM-yyyy");
                row[2] =  Strings.Format( Convert.ToDate(dataRow["post_date"]), "dd-MMM-yyyy");
                row[3] = RuntimeHelpers.GetObjectValue(dataRow["cust_no"]);
                row[4] = RuntimeHelpers.GetObjectValue(dataRow["title_code"]);
                row[5] = RuntimeHelpers.GetObjectValue(dataRow["names"]);
                row[6] = RuntimeHelpers.GetObjectValue(dataRow["sex"]);
                row[7] =  dataRow["birthdate"].ToString();
                row[8] = RuntimeHelpers.GetObjectValue(dataRow["account_no"]);
                row[9] = RuntimeHelpers.GetObjectValue(dataRow["account_desc"]);
                row[10] = RuntimeHelpers.GetObjectValue(dataRow["address"]);
                row[11] = RuntimeHelpers.GetObjectValue(dataRow["telephone"]);
                row[12] = RuntimeHelpers.GetObjectValue(dataRow["prod_code"]);
                row[13] = RuntimeHelpers.GetObjectValue(dataRow["headsub_code"]);
                row[14] =  "Pass";
                dataTable.Rows.Add(row);
            }
        }
        finally
        {
            IEnumerator enumerator;
            if (enumerator is IDisposable)
                (enumerator as IDisposable).Dispose();
        }
        this.DataGrid1.DataSource =  dataTable;
        this.DataGrid1.DataBind();
        this.DataGrid1.Columns[2].HeaderStyle.Wrap = false;
        this.DataGrid1.Columns[2].ItemStyle.Wrap = false;
        this.DataGrid1.Columns[1].HeaderStyle.Wrap = false;
        this.DataGrid1.Columns[1].ItemStyle.Wrap = false;
    }

    public void InsertAllRecordHr(string m_strFileName)
    {
        StreamReader streamReader = new StreamReader("C:\\TempMultipleFiles\\" + m_strFileName);
        DataSet dataSet = new DataSet();
        DataTable dataTable = new DataTable();
        dataTable.Columns.Add(new DataColumn(" Post Date   ", typeof(string)));
        dataTable.Columns.Add(new DataColumn("TransDate  ", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Account No", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Transaction Code", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Narrative", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Description ", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Debit", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Credit", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Bank Code", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Cheque No", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Reference Code", typeof(string)));
        dataTable.Columns.Add(new DataColumn("Remarks", typeof(string)));
        string str1;
        do
        {
            str1 = streamReader.ReadLine();
            Strings.Len(str1);
            int Length1 = Strings.InStr(str1, ",", CompareMethod.Binary);
            string str2 = Strings.Mid(str1, 1, Length1);
            string str3 = Strings.Mid(str1, checked(Length1 + 1));
            int Length2 = Strings.InStr(str3, ",", CompareMethod.Binary);
            string str4 = Strings.Mid(str3, 1, Length2);
            string str5 = Strings.Mid(str1, checked(Length1 + Length2 + 1));
            int Length3 = Strings.InStr(str5, ",", CompareMethod.Binary);
            string str6 = Strings.Mid(str5, 1, Length3);
            string str7 = Strings.Mid(str1, checked(Length1 + Length2 + Length3 + 1));
            int Length4 = Strings.InStr(str7, ",", CompareMethod.Binary);
            string str8 = Strings.Mid(str7, 1, Length4);
            string str9 = Strings.Mid(str1, checked(Length1 + Length2 + Length3 + Length4 + 1));
            int Length5 = Strings.InStr(str9, ",", CompareMethod.Binary);
            string str10 = Strings.Mid(str9, 1, Length5);
            string str11 = Strings.Mid(str1, checked(Length1 + Length2 + Length3 + Length4 + Length5 + 1));
            int Length6 = Strings.InStr(str11, ",", CompareMethod.Binary);
            string str12 = Strings.Mid(str11, 1, Length6);
            string str13 = Strings.Mid(str1, checked(Length1 + Length2 + Length3 + Length4 + Length5 + Length6 + 1));
            int Length7 = Strings.InStr(str13, ",", CompareMethod.Binary);
            string str14 = Strings.Mid(str13, 1, Length7);
            string str15 = Strings.Mid(str1, checked(Length1 + Length2 + Length3 + Length4 + Length5 + Length6 + Length7 + 1));
            int Length8 = Strings.InStr(str15, ",", CompareMethod.Binary);
            string str16 = Strings.Mid(str15, 1, Length8);
            string str17 = Strings.Mid(str1, checked(Length1 + Length2 + Length3 + Length4 + Length5 + Length6 + Length7 + Length8 + 1));
            int Length9 = Strings.InStr(str17, ",", CompareMethod.Binary);
            string str18 = Strings.Mid(str17, 1, Length9);
            string str19 = Strings.Mid(str1, checked(Length1 + Length2 + Length3 + Length4 + Length5 + Length6 + Length7 + Length8 + Length9 + 1));
            int Length10 = Strings.InStr(str19, ",", CompareMethod.Binary);
            Strings.Mid(str19, 1, Length10);
            Strings.Mid(str1, checked(Length1 + Length2 + Length3 + Length4 + Length5 + Length6 + Length7 + Length8 + Length9 + Length10 + 1));
            string Expression1 = Strings.Format( NETClass.EazyClass.GetPostingDate(), "dd-MMM-yyy");
            string str20 = str2;
            string str21 = str4;
            string str22 = "016";
            string Expression2 = str6;
            string str23 = str8;
            string str24 = str10;
            string str25 = str12;
            string str26 = str14;
            string str27 = str16;
            string str28 = str18;
            if (string.Compare(Strings.Trim(str20), (string)null, false) != 0)
            {
                DataRow row = dataTable.NewRow();
                row[0] =  Strings.Replace(Strings.Replace(Expression1, ",", "", 1, -1, CompareMethod.Binary), ",", "", 1, -1, CompareMethod.Binary);
                row[1] =  str20.Replace(",", "").Replace(",", "");
                row[2] =  Strings.Trim(str21.Replace(",", ""));
                row[3] =  Strings.Trim(str22.Replace(",", ""));
                row[4] =  Strings.Replace(Strings.Replace(Expression2, ",", "", 1, -1, CompareMethod.Binary), ",", "", 1, -1, CompareMethod.Binary);
                row[5] =  str23.Replace(",", "").Replace(",", "");
                row[6] =  Strings.Trim(str24.Replace(",", ""));
                row[7] =  Strings.Trim(str25.Replace(",", ""));
                row[8] =  Strings.Trim(str26.Replace(",", ""));
                row[9] =  Strings.Trim(str27.Replace(",", ""));
                row[10] =  Strings.Trim(str28.Replace(",", ""));
                row[11] =  "Pass";
                dataTable.Rows.Add(row);
            }
        }
        while (str1 != null);
        streamReader.Close();
        this.DataGrid1.DataSource =  dataTable;
        this.DataGrid1.DataBind();
        string Left = this.ValidateEntriesHr();
        if (string.Compare(Left, (string)null, false) == 0)
            return;
        this.Response.Write("<script>alert(' The following entries are with errors !!" + Left + "') </script>");
    }

    public string ValidateEntries()
    {
